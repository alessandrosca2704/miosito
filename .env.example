CAL_API_KEY=
NEWSTYLE_ADMIN_USERNAME=
NEWSTYLE_ADMIN_PASSWORD_HASH=
NEWSTYLE_SESSION_SECRET=
# Required: comma-separated IDs. Empty configuration denies access.
NEWSTYLE_CAL_EVENT_TYPE_IDS=
# Only for an explicitly dedicated account; IDs take precedence if configured.
NEWSTYLE_CAL_ALLOW_ALL_EVENTS=false
# Optional, defaults to https://api.cal.com/v2
CAL_API_BASE_URL=
# Device authentication; the activation code itself is never deployed.
NEWSTYLE_ACTIVATION_CODE_HASH=
# Explicit browser/Capacitor origins, comma-separated.
NEWSTYLE_ALLOWED_ORIGINS=https://localhost
# Local development origins, comma-separated.
NEWSTYLE_DEV_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Public client configuration for the future Vite/Capacitor app.
VITE_API_BASE_URL=https://alessandroscarimbolo.it/api/newstyle
